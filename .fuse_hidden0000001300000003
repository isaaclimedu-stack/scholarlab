.doc.on { display: block; }
.grid { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 32px; align-items: start; padding: 20px 0 64px; }
.toc { position: sticky; top: 132px; font-size: 14px; }
.toc b { display: block; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px 12px; }
.toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--line); }
.toc a { display: block; padding: 5px 12px; margin-left: -2px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; line-height: 1.4; }
.toc a:hover { color: var(--ink); }
.toc a.cur { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }

.card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 8px 30px 18px; }
.short { background: var(--accent-soft); border-radius: 14px; padding: 18px 22px; margin: 0 0 18px; }
.short h2 { margin: 0 0 8px; font-size: 15px; letter-spacing: .02em; }
.short ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; }
.short li { position: relative; padding-left: 26px; font-size: 15px; line-height: 1.5; }
.short li::before { content: ""; position: absolute; left: 2px; top: 5px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); -webkit-mask: radial-gradient(circle, #000 0 3px, transparent 3.5px), linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .9; }
.card h3 { font-size: 18px; line-height: 1.35; margin: 0; padding: 22px 0 6px; border-top: 1px solid var(--line); }
.card h3:first-child { border-top: 0; }
.card p, .card li { font-size: 15.5px; }
.card p { margin: 8px 0; }
.card ul { padding-left: 20px; margin: 8px 0 12px; }
.card li { margin: 5px 0; }
.card li::marker { color: var(--muted); }
.tw { overflow-x: auto; margin: 12px 0 16px; border: 1px solid var(--line); border-radius: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 560px; }
th, td { text-align: left; vertical-align: top; padding: 10px 14px; border-bottom: 1px solid var(--line); line-height: 1.5; }
tr:last-child td { border-bottom: 0; }
th { font-size: 12.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); background: var(--sunk); }
td:first-child { font-weight: 600; }
th:nth-child(1) { width: 24%; } th:nth-child(2) { width: 42%; }
.foot { color: var(--muted); font-size: 13.5px; margin: 18px 4px 0; }

.mtoc { display: none; }
@media (max-width: 860px) {
