    : { name: 'Comma', mark: 'C', accent: '#1d3e9e', dark: '#93b1ff', soft: '#e8edfa', url: 'https://www.comma-ltd.com' };
  const dark = matchMedia('(prefers-color-scheme: dark)').matches && document.documentElement.dataset.theme !== 'light';
  if (!dark) { document.documentElement.style.setProperty('--accent', SITE.accent); document.documentElement.style.setProperty('--accent-soft', SITE.soft); }
  else document.documentElement.style.setProperty('--accent', SITE.dark);
  document.getElementById('brandName').textContent = SITE.name; document.getElementById('mark').textContent = SITE.mark;
  document.getElementById('back').innerHTML = '← Back<span class="lg"> to ' + SITE.name + '</span>';
  const home = /^(localhost|127\.|file)/.test(host) || !host ? SITE.url : '/';
  document.getElementById('brand').href = home; document.getElementById('back').href = home;

  /* contents lists */
  const docs = [...document.querySelectorAll('.doc')];
  docs.forEach(d => {
    const hs = [...d.querySelectorAll('.card h3')];
    const items = hs.map(h => `<li><a href="#${h.id}" data-h="${h.id}">${h.textContent.replace(/^\d+\.\s*/, '')}</a></li>`).join('');
    d.querySelector('.toc').innerHTML = '<b>On this page</b><ol>' + items + '</ol>';
    d.querySelector('.mtoc').insertAdjacentHTML('beforeend', '<ol>' + items + '</ol>');
  });
  document.querySelectorAll('.mtoc a').forEach(a => a.addEventListener('click', () => a.closest('details').open = false));

  /* tabs: #terms, #privacy, #guidelines (or a section inside one, like #privacy-3) */
  const tabs = [...document.querySelectorAll('.tab')];
  let cur = null;
  function show(fromHash) {
    const h = decodeURIComponent(location.hash.slice(1)), key = (h.split('-')[0]) || 'terms';
    const doc = docs.find(d => d.id === key) || docs[0];
    if (doc !== cur) {
      docs.forEach(d => d.classList.toggle('on', d === doc));
      tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.doc === doc.id)));
      document.title = doc.querySelector('h1').textContent + ' · ' + SITE.name;
      cur = doc;
    }
    const sec = h && h !== doc.id && document.getElementById(h);
    if (sec) sec.scrollIntoView(); else if (fromHash) window.scrollTo(0, 0);
    spy();
  }
  /* highlight the section being read */
  function spy() {
    if (!cur) return; const hs = [...cur.querySelectorAll('.card h3')]; let on = hs[0];
    for (const h of hs) if (h.getBoundingClientRect().top < 170) on = h;
    cur.querySelectorAll('.toc a').forEach(a => a.classList.toggle('cur', on && a.dataset.h === on.id));
  }
  addEventListener('hashchange', () => show(true));
  addEventListener('scroll', spy, { passive: true });
  show(false);
})();
</script>
</body>
</html>
